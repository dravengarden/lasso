#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: setup-trusted-publisher CRATE... [--repo OWNER/REPO]
       [--workflow FILE] [--environment NAME] [--print]

Prepare the fields for crates.io GitHub Actions Trusted Publisher bindings.
Every crate must already have a first published version.
EOF
}

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
	usage
	exit 0
fi

crates=()
while [[ -n ${1:-} && ${1:-} != -* ]]; do
	crates+=("$1")
	shift
done
((${#crates[@]} > 0)) || {
	usage >&2
	exit 2
}

repository=
workflow=publish-cargo.yml
environment=
print_only=0
while (($#)); do
	case $1 in
	--repo)
		repository=${2:?--repo requires OWNER/REPO}
		shift 2
		;;
	--workflow)
		workflow=${2:?--workflow requires a filename}
		shift 2
		;;
	--environment)
		environment=${2:?--environment requires a name}
		shift 2
		;;
	--print)
		print_only=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		printf 'setup-trusted-publisher: unknown argument: %s\n' "$1" >&2
		exit 2
		;;
	esac
done

for crate in "${crates[@]}"; do
	[[ $crate =~ ^[A-Za-z0-9]+([_-][A-Za-z0-9]+)*$ ]] || {
		printf 'setup-trusted-publisher: invalid crates.io crate: %s\n' "$crate" >&2
		exit 2
	}
done
[[ $workflow =~ ^[A-Za-z0-9_.-]+\.ya?ml$ ]] || {
	printf 'setup-trusted-publisher: workflow must be a .yml or .yaml filename\n' >&2
	exit 2
}
[[ -z $environment || (${#environment} -le 255 && ! $environment =~ [[:cntrl:]]) ]] || {
	printf 'setup-trusted-publisher: invalid GitHub environment: %s\n' "$environment" >&2
	exit 2
}

repo_root=$(git rev-parse --show-toplevel)
[[ -f $repo_root/.github/workflows/$workflow ]] || {
	printf 'setup-trusted-publisher: missing .github/workflows/%s\n' "$workflow" >&2
	exit 1
}
if [[ -z $repository ]]; then
	repository=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
fi
[[ $repository =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
	printf 'setup-trusted-publisher: invalid GitHub repository: %s\n' "$repository" >&2
	exit 2
}

owner=${repository%%/*}
repo=${repository#*/}
printf 'crates.io trusted publisher\n'
printf 'Owner: %s\nRepository: %s\nWorkflow: %s\nEnvironment: %s\n' \
	"$owner" "$repo" "$workflow" "${environment:-(Any)}"
for crate in "${crates[@]}"; do
	printf 'Crate: %s\nURL: https://crates.io/crates/%s/settings/new-trusted-publisher\n' \
		"$crate" "$crate"
done

if ((print_only)); then
	exit 0
fi

failed=0
for crate in "${crates[@]}"; do
	url="https://crates.io/crates/$crate/settings/new-trusted-publisher"
	if command -v xdg-open >/dev/null 2>&1 && xdg-open "$url"; then
		continue
	fi
	if command -v open >/dev/null 2>&1 && open "$url"; then
		continue
	fi
	printf 'setup-trusted-publisher: browser did not open for %s; use its URL above\n' "$crate" >&2
	failed=1
done
((failed == 0))
