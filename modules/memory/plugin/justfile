set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

format-check:
    cd scripts/agent_tools && uv run ruff format --check .
    shfmt -d -i 4 -ci -bn scripts/memory-sync scripts/memory-bridge scripts/tidy-candidates

lint:
    cd scripts/agent_tools && uv run ruff check . && uv run ty check .
    shellcheck scripts/memory-sync scripts/memory-bridge scripts/tidy-candidates

test:
    cd scripts/agent_tools && uv run --group dev pytest

verify: format-check lint test
